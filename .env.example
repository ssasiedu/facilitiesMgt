# ---------------------------------------------------------------------------
# Frontend (Vite) – safe to expose: the anon key is protected by Row Level Security.
# Copy this file to .env for local development.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_NAME=FacilitiesManagement
VITE_PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Edge Function secrets – NEVER put these in .env for the frontend.
# Set them with:  supabase secrets set NAME=value   (or Dashboard > Edge Functions > Secrets)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
# ---------------------------------------------------------------------------
# SMS (provider is chosen in Settings; this is the fallback)
SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
MNOTIFY_API_KEY=
SMS_SENDER_ID=
# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Your Company <billing@yourdomain.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Payments (optional – enable "Online payments" in Settings)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
HUBTEL_MERCHANT_ACCOUNT=
# Other
CRON_SECRET=generate-a-long-random-string
PUBLIC_APP_URL=https://app.yourdomain.com
ALLOWED_ORIGIN=*
